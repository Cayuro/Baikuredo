@model Baikuredo.Web.DTOs.Motorcycles.MotorcycleDTO

@{
    ViewData["Title"] = "Eliminar moto";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Eliminar moto</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        ¿Estás seguro de que deseas eliminar esta moto?
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Placa</dt>
                        <dd class="col-sm-8">@Model.Plate</dd>

                        <dt class="col-sm-4">Marca / Modelo</dt>
                        <dd class="col-sm-8">@Model.BrandName @Model.ModelName</dd>

                        <dt class="col-sm-4">Propietario</dt>
                        <dd class="col-sm-8">@Model.OwnerName</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger">
                                Eliminar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
