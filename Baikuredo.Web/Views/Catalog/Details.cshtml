@model Baikuredo.Web.DTOs.Catalog.CatalogDetailDTO

@{
    ViewData["Title"] = $"{Model.BrandName} {Model.ModelName}";
    var mainPhoto = Model.Photos.FirstOrDefault(p => p.IsMain) ?? Model.Photos.FirstOrDefault();
}

<div class="pagetitle">
    <h1>@Model.BrandName @Model.ModelName (@Model.Year)</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Catálogo</a></li>
            <li class="breadcrumb-item active">Detalle</li>
        </ol>
    </nav>
</div>

<section class="section">

    <div class="row">

        @* COLUMNA IZQUIERDA: FOTOS Y FICHA TÉCNICA *@
        <div class="col-lg-8">

            @* GALERÍA DE FOTOS *@
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Fotos (@Model.Photos.Count)</h5>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left"></i> Volver al catálogo
                    </a>
                </div>
                <div class="card-body pt-3">
                    @if (Model.Photos.Any())
                    {
                        @if (mainPhoto != null)
                        {
                            <div class="mb-3 text-center">
                                <img id="mainGalleryImage" src="@mainPhoto.Url" class="img-fluid rounded border" alt="@Model.BrandName @Model.ModelName" style="max-height: 420px; width: 100%; object-fit: cover;" />
                            </div>
                        }

                        @if (Model.Photos.Count > 1)
                        {
                            <div class="row g-2">
                                @foreach (var photo in Model.Photos)
                                {
                                    <div class="col-4 col-md-3">
                                        <div class="card h-100 @(photo.IsMain ? "border-primary border-2" : "")">
                                            <img src="@photo.Url"
                                                 class="card-img-top rounded catalog-thumb"
                                                 alt="Miniatura"
                                                 style="height: 100px; object-fit: cover; cursor: pointer;"
                                                 onclick="document.getElementById('mainGalleryImage').src = this.src;" />
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="bg-light rounded d-flex flex-column align-items-center justify-content-center text-muted py-5">
                            <i class="bi bi-bicycle" style="font-size: 4rem;"></i>
                            <span>Esta publicación aún no cuenta con fotografías</span>
                        </div>
                    }
                </div>
            </div>

            @* ESPECIFICACIONES DE LA MOTO *@
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0 text-primary fw-bold">
                        @($"${Model.SalePrice:N0}")
                        <span class="badge bg-success ms-2">Disponible</span>
                    </h4>
                    <span class="badge bg-secondary">@Model.CategoryName</span>
                </div>
                <div class="card-body pt-3">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row mb-0">
                                <dt class="col-sm-5">Marca</dt>
                                <dd class="col-sm-7">@Model.BrandName</dd>

                                <dt class="col-sm-5">Modelo</dt>
                                <dd class="col-sm-7">@Model.ModelName</dd>

                                <dt class="col-sm-5">Categoría</dt>
                                <dd class="col-sm-7">@Model.CategoryName</dd>

                                <dt class="col-sm-5">Año</dt>
                                <dd class="col-sm-7">@Model.Year</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row mb-0">
                                <dt class="col-sm-5">Cilindraje</dt>
                                <dd class="col-sm-7">@Model.Displacement cc</dd>

                                <dt class="col-sm-5">Kilometraje</dt>
                                <dd class="col-sm-7">@($"{Model.Mileage:N0} km")</dd>

                                <dt class="col-sm-5">Color</dt>
                                <dd class="col-sm-7">@Model.Color</dd>

                                <dt class="col-sm-5">Publicada</dt>
                                <dd class="col-sm-7">@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</dd>
                            </dl>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <hr />
                        <h6><strong>Descripción</strong></h6>
                        <p class="mb-0">@Model.Description</p>
                    }
                </div>
            </div>

        </div>

        @* COLUMNA DERECHA: FORMULARIO PÚBLICO DE INTERÉS (F003) *@
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-chat-left-text me-1"></i> ¿Te interesa esta moto?</h5>
                </div>
                <div class="card-body pt-3">
                    <p class="small text-muted">
                        Déjanos tus datos de contacto y un asesor se comunicará contigo lo antes posible.
                    </p>

                    <form asp-action="RegisterInterest" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <input type="hidden" asp-for="Interest.MotorcyclePublicationId" />

                        <div class="mb-3">
                            <label asp-for="Interest.FullName" class="form-label"></label>
                            <input asp-for="Interest.FullName" class="form-control" placeholder="Ej: Carlos Pérez" />
                            <span asp-validation-for="Interest.FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Interest.Email" class="form-label"></label>
                            <input asp-for="Interest.Email" type="email" class="form-control" placeholder="ejemplo@correo.com" />
                            <span asp-validation-for="Interest.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Interest.Phone" class="form-label"></label>
                            <input asp-for="Interest.Phone" class="form-control" placeholder="Ej: 3001234567" />
                            <span asp-validation-for="Interest.Phone" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Interest.Message" class="form-label"></label>
                            <textarea asp-for="Interest.Message" class="form-control" rows="3" placeholder="¿Tienes alguna pregunta o deseas agendar una cita?"></textarea>
                            <span asp-validation-for="Interest.Message" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-send"></i> Enviar solicitud
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>

</section>
