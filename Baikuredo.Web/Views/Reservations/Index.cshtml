@using Baikuredo.Web.DTOs.Reservations
@using Baikuredo.Web.Core.Enums
@model Baikuredo.Web.Core.Pagination.PaginationResponse<ReservationDTO>
@inject Baikuredo.Web.Services.Abstractions.IAccountService AccountService
@{
    // Cada botón se muestra solo si el rol del usuario tiene el permiso de esa acción
    bool canCreate = await AccountService.AccountUserIsAuthorizedAsync("reservations.create");
    bool canUpdate = await AccountService.AccountUserIsAuthorizedAsync("reservations.update");
    bool canDelete = await AccountService.AccountUserIsAuthorizedAsync("reservations.delete");
}

@{
    ViewData["Title"] = "Reservas";
}

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">

    <div class="card">

        <div class="card-header">

            <div class="row">

                <h3 class="m-0 font-weight-bold text-primary col-md-11">@ViewData["Title"]</h3>

                <div class="col-md-1 text-end">
                    @if (canCreate)
                    {
                        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i></a>
                    }
                </div>

            </div>

        </div>

        <div class="card-body mt-3">

            <form asp-action="Index" class="navbar-search" method="GET">

                <input type="hidden" name="Page" value="@Model.CurrentPage" />

                <div class="row mt-3">

                    <div class="col-md-auto">
                        <select asp-for="RecordsPerPage" class="form-select bg-light border-0 small">
                            <option value="10" selected="@(Model.RecordsPerPage == 10)">10</option>
                            <option value="15" selected="@(Model.RecordsPerPage == 15)">15</option>
                            <option value="30" selected="@(Model.RecordsPerPage == 30)">30</option>
                            <option value="50" selected="@(Model.RecordsPerPage == 50)">50</option>
                        </select>
                    </div>

                    <div class="col-md-10">
                        <div class="input-group mb-3">
                            <input type="text" class="form-control bg-light border-0 small" placeholder="Buscar..." aria-label="search" asp-for="Filter" />
                            <button class="btn btn-primary"><i class="bi bi-search"></i></button>
                        </div>
                    </div>

                </div>

            </form>

            <table class="table table-bordered">

                <thead>
                    <tr>
                        <th>Moto</th>
                        <th>Cliente</th>
                        <th>Teléfono</th>
                        <th>Anticipo</th>
                        <th>Reservada</th>
                        <th>Vence</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.List != null && Model.List.Any())
                    {
                        @foreach (ReservationDTO item in Model.List)
                        {
                            <tr>
                                <td>@item.MotorcycleText</td>
                                <td>@item.CustomerName</td>
                                <td>@item.CustomerPhone</td>
                                <td>@($"${item.DepositAmount:N0}")</td>
                                <td>@item.ReservedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                <td>@item.ExpiresAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                <td><span class="badge @item.Status.BadgeClass()">@item.Status.ToSpanish()</span></td>
                                <td>
                                    @if (canUpdate && item.Status == ReservationStatus.Active)
                                    {
                                        <form asp-action="Complete" method="POST" style="display: contents;">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button class="btn btn-sm btn-success btnConfirm" title="Completar (vendida)" data-question="¿Confirmar que la moto se vendió?">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </form>

                                        <form asp-action="Expire" method="POST" style="display: contents;">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button class="btn btn-sm btn-secondary btnConfirm" title="Expirar (liberar moto)" data-question="¿Expirar la reserva y liberar la moto?">
                                                <i class="bi bi-clock-history"></i>
                                            </button>
                                        </form>
                                    }

                                    <a class="btn btn-sm btn-info" asp-controller="Publications" asp-action="Details" asp-route-id="@item.MotorcyclePublicationId" title="Ver publicación">
                                        <i class="bi bi-images"></i>
                                    </a>

                                    @if (canDelete)
                                    {
                                        <form asp-action="Delete" method="POST" style="display: contents;" asp-route-id="@item.Id">
                                            <button type="submit" class="btn btn-sm btn-danger btnDelete" title="Eliminar">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center">No hay reservas registradas.</td>
                        </tr>
                    }
                </tbody>

            </table>

            @await Html.PartialAsync("_PaginationComponent", Model)

        </div>
    </div>

</section>

@section Scripts {

    <script>

        $(document).ready(function() {

            $('.btnDelete').click(function(event) {

                event.preventDefault();

                Swal.fire({
                    icon: 'warning',
                    title: '¿Desea eliminar la reserva?',
                    text: "¡No podrás revertir esto!",
                    showCancelButton: true,
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d'
                }).then((result) => {

                    if (result.isConfirmed) {
                        const form = $(this).closest('form');
                        form.submit();
                    }
                });
            });

            $('.btnConfirm').click(function(event) {

                event.preventDefault();

                Swal.fire({
                    icon: 'question',
                    title: $(this).data('question'),
                    showCancelButton: true,
                    confirmButtonText: 'Sí',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {

                    if (result.isConfirmed) {
                        const form = $(this).closest('form');
                        form.submit();
                    }
                });
            });

            $('#RecordsPerPage').change(function() {
                $(this).closest('form').submit();
            });
        });

    </script>

}
