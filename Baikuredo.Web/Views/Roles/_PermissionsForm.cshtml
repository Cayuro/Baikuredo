@model Baikuredo.Web.DTOs.Roles.RoleFormDTO

@*
    Formulario compartido por Create y Edit.
    Los permisos se envían como una lista: Permissions[0].Id, Permissions[0].Selected, Permissions[1].Id...
    Por eso se recorren con un for (con índice) y no con un foreach.
*@

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-4">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" placeholder="Ej: Vendedor" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<h5 class="mb-3">Permisos</h5>

<div class="row">
    @foreach (var module in Model.Permissions.Select((p, index) => new { Permission = p, Index = index }).GroupBy(x => x.Permission.Module))
    {
        string moduleKey = module.Key.Replace(" ", "");

        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-header py-2">
                    <div class="form-check mb-0">
                        <input class="form-check-input checkModule" type="checkbox" id="module_@moduleKey" data-module="@moduleKey" />
                        <label class="form-check-label fw-bold" for="module_@moduleKey">@module.Key</label>
                    </div>
                </div>
                <div class="card-body py-2">
                    @foreach (var item in module)
                    {
                        int i = item.Index;

                        <div class="form-check">
                            <input type="hidden" asp-for="Permissions[i].Id" />
                            <input type="hidden" asp-for="Permissions[i].Code" />
                            <input type="hidden" asp-for="Permissions[i].Description" />
                            <input type="hidden" asp-for="Permissions[i].Module" />
                            <input class="form-check-input checkPermission" type="checkbox" asp-for="Permissions[i].Selected" data-module="@moduleKey" />
                            <label class="form-check-label" asp-for="Permissions[i].Selected" title="@Model.Permissions[i].Code">
                                @Model.Permissions[i].Description
                            </label>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
