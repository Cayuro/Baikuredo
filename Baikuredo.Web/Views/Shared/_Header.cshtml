@inject Baikuredo.Web.Services.Abstractions.IAccountService AccountService
@{
    bool isAuthenticated = AccountService.AccountUserIsAuthenticated();
}

<header id="header" class="header fixed-top d-flex align-items-center">

    <!-- Logo y botón para abrir/cerrar el menú lateral -->
    <div class="d-flex align-items-center justify-content-between">
        <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center">
            <img src="~/assets/img/logo.png" alt="Logo">
            <span class="d-none d-lg-block">Baikuredo</span>
        </a>
        <i class="bi bi-list toggle-sidebar-btn"></i>
    </div>

    <nav class="header-nav ms-auto">
        <ul class="d-flex align-items-center">

            @if (isAuthenticated)
            {
                @* Menú desplegable del usuario *@
                <li class="nav-item dropdown pe-3">

                    <a class="nav-link nav-profile d-flex align-items-center pe-0" href="#" data-bs-toggle="dropdown">
                        <img src="~/assets/img/profile-img.jpg" alt="Perfil" class="rounded-circle">
                        <span class="d-none d-md-block dropdown-toggle ps-2">@User.Identity?.Name</span>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
                        <li class="dropdown-header">
                            <h6>@User.Identity?.Name</h6>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center" asp-controller="Account" asp-action="Profile">
                                <i class="bi bi-person"></i>
                                <span>Mi cuenta</span>
                            </a>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center" asp-controller="Account" asp-action="ChangePassword">
                                <i class="bi bi-key"></i>
                                <span>Cambiar contraseña</span>
                            </a>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            @* Cerrar sesión va por POST (con token antifalsificación), no por un enlace *@
                            <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                                <button type="submit" class="dropdown-item d-flex align-items-center">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Cerrar sesión</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </li>
            }
            else
            {
                <li class="nav-item pe-3">
                    <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">
                        <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
                    </a>
                </li>
            }

        </ul>
    </nav>

</header>
