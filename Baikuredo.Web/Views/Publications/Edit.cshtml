@model Baikuredo.Web.DTOs.Publications.UpdatePublicationDTO

@{
    ViewData["Title"] = "Editar publicación";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">Editar publicación</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input asp-for="Id" type="hidden" />
                        <input asp-for="MotorcycleText" type="hidden" />

                        <div class="mb-3">
                            <label class="form-label">Moto</label>
                            <input class="form-control" value="@Model.MotorcycleText" disabled />
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="SalePrice" class="form-label"></label>
                                <input asp-for="SalePrice" class="form-control" />
                                <span asp-validation-for="SalePrice" class="text-danger"></span>
                                <div class="form-text">Si cambia el precio, queda guardado en el historial.</div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Mileage" class="form-label"></label>
                                <input asp-for="Mileage" class="form-control" />
                                <span asp-validation-for="Mileage" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Status" class="form-label"></label>
                                <select asp-for="Status" asp-items="Model.Statuses" class="form-select"></select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                                Volver
                            </a>
                            <button type="submit" class="btn btn-primary">
                                Guardar cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
